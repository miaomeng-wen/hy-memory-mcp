# Copy to .env and configure your own provider. Never commit .env.
# Start the server from the project directory so ./data stays project-local.
MEMORY_MODE="lite"
MEMORY_DATA_DIR="./data"
MEMORY_DEFAULT_USER_ID="default"
MEMORY_DEFAULT_AGENT_ID="default_agent"
MEMORY_MCP_HOST="127.0.0.1"
MEMORY_MCP_PORT="19527"

# Embedding requests may be billed by the provider, including lite/import mode.
MEMORY_EMBEDDER_PROVIDER="openai"
MEMORY_EMBEDDER_BASE_URL="https://api.openai.com/v1"
MEMORY_EMBEDDER_MODEL="text-embedding-3-small"
MEMORY_EMBEDDING_DIMS="1536"
MEMORY_EMBEDDER_API_KEY=""
MEMORY_EMBEDDER_TIMEOUT="15"
MEMORY_EMBEDDER_MAX_RETRIES="2"
MEMORY_EMBEDDER_RETRY_DELAY="0.3"

# Required when you switch to pro/ultra. Use your own compatible model.
MEMORY_LLM_PROVIDER="openai"
MEMORY_LLM_BASE_URL="https://api.openai.com/v1"
MEMORY_LLM_MODEL=""
MEMORY_LLM_API_KEY=""

HYIMPORT_MAX_WRITES="50"
HYIMPORT_MAX_SECONDS="120"
HYIMPORT_DAILY_LIMIT="500"
# Optional source overrides; unset values use the current user's home directory.
# CODEX_HOME="C:/Users/your-user/.codex"
# DSH_SESSIONS_DIR="C:/Users/your-user/.dsh/sessions"
# ZCODE_ROLLOUT_DIR="C:/Users/your-user/.zcode/cli/rollout"
# HYIMPORT_NODE="C:/Program Files/nodejs/node.exe"
