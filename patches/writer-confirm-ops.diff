+    def _reject_malformed_items(extracted_info: Dict[str, Any]) -> str:
+        """拒绝形状不合 schema 的抽取项，返回空串表示可接受。
+
+        extractor 已做结构校验，这里是落地前的第二道闸：即便上游改了校验，
+        ``{"memory": "two facts"}`` 这类值也不能被静默当成"无事实"清空，
+        ``memory`` 里混进字符串/缺 content 的项也不能被静默跳过。
+        """
+        if not isinstance(extracted_info, dict):
+            return f"extracted_info is {type(extracted_info).__name__}"
+        for key in ("memory", "facts", "identity", "intentions"):
+            if key not in extracted_info:
+                continue
+            items = extracted_info.get(key)
+            if items is None:
+                continue
+            if not isinstance(items, list):
+                return f"{key} must be a list, got {type(items).__name__}"
+            for idx, item in enumerate(items):
+                if not isinstance(item, dict):
+                    return f"{key}[{idx}] must be an object, got {type(item).__name__}"
+                if not str(item.get("content") or "").strip():
+                    return f"{key}[{idx}] has no content"
+        for key in ("basic_info", "profile"):
+            if key not in extracted_info:
+                continue
+            value = extracted_info.get(key)
+            if value is not None and not isinstance(value, dict):
+                return f"{key} must be an object, got {type(value).__name__}"
+        return ""
